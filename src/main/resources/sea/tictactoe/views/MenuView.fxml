<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="299.0" prefWidth="517.0" styleClass="menu-container" stylesheets="@../styles/style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="sea.tictactoe.gui.controllers.MenuController">
   <children>
      <Label styleClass="title-lbl" text="Tic Tac Toe" />
      <HBox alignment="CENTER" prefHeight="247.0" prefWidth="292.0" spacing="35.0">
         <children>
            <Button fx:id="btnSingleplayer" mnemonicParsing="false" onAction="#openGameboard" prefHeight="39.0" prefWidth="164.0" styleClass="singleplayer-btn" text="Single-Player" />
            <Button fx:id="btnMultiplayer" mnemonicParsing="false" onAction="#openGameboard" prefHeight="39.0" prefWidth="164.0" styleClass="multiplayer-btn" text="Multiplayer" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="45.0" left="45.0" right="45.0" top="45.0" />
   </padding>
</VBox>
