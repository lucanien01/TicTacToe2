<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<VBox alignment="CENTER" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="sea.tictactoe.gui.controllers.MenuController">
   <children>
      <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Tic Tac Toe" wrappingWidth="123.73665046691895">
         <font>
            <Font name="System Bold" size="23.0" />
         </font>
         <VBox.margin>
            <Insets />
         </VBox.margin>
      </Text>
      <HBox alignment="CENTER" prefHeight="247.0" prefWidth="292.0" spacing="35.0">
         <children>
            <Button fx:id="btnSingleplayer" mnemonicParsing="false" onAction="#openGameboard" text="Single-Player" />
            <Button fx:id="btnMultiplayer" mnemonicParsing="false" onAction="#openGameboard" text="Multiplayer" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="45.0" left="45.0" right="45.0" top="45.0" />
   </padding>
</VBox>
